# As variáveis do site em produção (spec §10, §11; veja também apps/site/.env.example). Copie
# para `app.env` ao lado do docker-compose.yml na VPS. DATABASE_URL não entra aqui: o
# docker-compose.yml monta a partir do DB_PASSWORD do `.env`.

# Segredo que cifra o cookie de sessão. `openssl rand -base64 33`.
AUTH_SECRET=
# A OAuth App de produção (github.com/settings/developers), callback
# https://<domínio>/api/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Atrás do Nginx o Auth.js confia no Host recebido; AUTH_URL fixa a origem do callback (sem ela,
# o redirect_uri das rotas /api/auth/* sai com o endereço interno do contêiner, 0.0.0.0:3000).
AUTH_TRUST_HOST=true
AUTH_URL=https://<domínio>

# A origem pública: canonical, sitemap, JSON-LD, llms.txt, Open Graph. Lida em tempo de execução.
SITE_URL=https://<domínio>

# Umami: o script da instância própria e o id do site, que o Umami mostra em "Add website". Vazias
# = nenhum script de estatística (o site funciona igual).
UMAMI_SCRIPT_URL=https://stats.<domínio>/script.js
UMAMI_WEBSITE_ID=

# O id numérico do GitHub do dono (só ele vê /lista-de-espera/contagem). `gh api users/<login> -q .id`.
DONO_GITHUB_ID=64616108
