# Configuração do Compose (spec §11): tag da imagem e senhas. Copie para `.env` ao lado do
# docker-compose.yml na VPS. As variáveis do site ficam em `app.env` (veja app.env.example); daqui
# só a senha do banco chega ao site, dentro do DATABASE_URL montado no docker-compose.yml.

APP_TAG=latest                            # ou sha-<commit>, para fixar uma versão (rollback)

# Senhas: `openssl rand -hex 32` para cada uma.
DB_PASSWORD=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
