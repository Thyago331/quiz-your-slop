# Variáveis do site (spec §10, §11). Localmente: copie para apps/site/.env.local (o Next lê os
# arquivos .env da pasta da app, não da raiz) e reinicie o `pnpm dev`.

# Segredo que cifra o cookie de sessão (JWT). Gere com `openssl rand -base64 33`.
AUTH_SECRET=
# GitHub OAuth App (github.com/settings/developers → New OAuth App). Callback em desenvolvimento:
#   http://localhost:3000/api/auth/callback/github
# Em produção, outra OAuth App com https://<domínio>/api/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Atrás do Nginx/Caddy (e em `next start` local) o Auth.js precisa confiar no Host recebido.
# AUTH_TRUST_HOST=true

# Postgres das contas. Com `docker compose -f compose.dev.yaml up -d` na raiz:
DATABASE_URL=postgres://quiz:quiz@localhost:5433/quiz

# A origem pública do site (canonical, sitemap, JSON-LD, llms.txt, Open Graph). Lida em tempo de
# execução; sem ela, http://localhost:3000.
# SITE_URL=https://quizyourslop.example
# Umami (spec §8): a URL do script da instância própria e o id deste site. As duas vazias (o padrão)
# = nenhum script de estatística.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
